    "express-rate-limit": "^8.7.0",
    "jsonwebtoken": "^9.0.3",
    "mongoose": "^9.10.2"
  },
  "devDependencies": {
    "mongodb-memory-server": "^11.3.0",
    "supertest": "^7.3.0",
    "vitest": "^5.0.2"
  },
  "allowScripts": {
    "esbuild@0.21.5": true,
    "mongodb-memory-server@11.3.0": true
  }
